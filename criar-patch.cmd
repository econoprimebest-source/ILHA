const fs=require('fs');fs.writeFileSync('patch-v2.js',`const fs=require('fs');const p='ilha.js';let s=fs.readFileSync(p,'utf8');const a='let estado={dia:1,comida:6,agua:8,madeira:5,abrigo:1,informacoes:[]}';const b="let estado=JSON.parse(fs.readFileSync('./estado-ilha.json','utf8'));estado.comida=estado.recursos.comida;estado.agua=estado.recursos.agua;estado.madeira=estado.recursos.madeira;estado.informacoes=estado.descobertas";if(!s.includes(a))throw new Error('Trecho esperado nao encontrado');fs.writeFileSync(p,s.replace(a,b));console.log('PATCH OK');`);
