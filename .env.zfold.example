# =============================================================================
# Configuração para rodar a ILHA no Z Fold (SM_F916B)
# =============================================================================
# Copie este arquivo para .env e ajuste os valores antes de rodar:
#   cp .env.zfold.example .env
#   node ilha.js 1

# ---- Provedor LLM (escolha UM) ----
# 'ollama'  -> LLM LOCAL no Z Fold (Termux + Ollama). Graça total, sem API externa.
# 'groq'    -> API grátis do Groq (qwen/qwen3.8-27b). Precisa de GROQ_API_KEY.
# 'deepseek'-> API DeepSeek. Precisa de DEEPSEEK_API_KEY (não recomendado se quiser grátis).
ILHA_LLM_PROVIDER=ollama

# Modelo usado pelo provedor escolhido
ILHA_MODELO=qwen3:8b

# Endpoint Ollama local do Z Fold (se rodando no próprio aparelho via Termux)
# Se o Ollama estiver no PC (failover), use o IP do PC na tailnet.
OLLAMA_URL=http://127.0.0.1:11434/api/chat

# Timeout da chamada LLM (ms). 60s é seguro para rede local/Tailscale.
ILHA_LLM_TIMEOUT_MS=60000

# ---- Cascata de decisão (adaptador-cerebro-zfold.js) ----
# Central Oficial no S23 Ultra (IP da tailnet do S23)
CENTRAL_HOST=100.117.219.66

# Failover direto para PC (se S23 não responder)
PC_HOST=100.95.183.57

# Portas da Central S23
ICARO_PORTA=8793
ELARA_PORTA=8794

# ---- Visão de cena (opt-in) ----
# Desligue no Z Fold para economizar bateria/dados. Ligue só se tiver modelo VL local.
ILHA_VISAO=0

# ---- Cognição opcional (ICARO mechanisms) ----
# Desligue por padrão no Z Fold (economia de recursos). Ligue só se precisar.
ILHA_COG=0

# Sem fallback para API externa paga (força uso de Ollama local ou falha honesta)
ILHA_SEM_FALLBACK=1

# =============================================================================
# COMO RODAR NO Z FOLD
# =============================================================================
# 1. Instale Termux no Z Fold e rode:
#    pkg install nodejs
#    npm install (no projeto)
# 2. Instale Ollama no Z Fold (ou use outro aparelho da tailnet com Ollama)
# 3. Defina as variáveis de ambiente (ou crie .env a partir deste arquivo)
# 4. Rode:
#    node ilha.js 1      (1 ciclo)
#    node ilha.js 30     (30 ciclos)
# =============================================================================
